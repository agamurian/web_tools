        "fast",
        "-pix_fmt",
        "yuv420p",
        "-c:a",
        "aac",
        "-b:a",
        "192k",
        "-movflags",
        "+faststart"
      ],
      "quality_args": {
        "small": [
          "-crf",
          "28"
        ],
        "balanced": [
          "-crf",
          "23"
        ],
        "high": [
          "-crf",
          "18"
        ]
      }
    },
