{
  "schema_version": 1,
  "sources": [
    "https://github.com/FFmpeg/FFmpeg/blob/n7.1/doc/muxers.texi",
    "https://github.com/FFmpeg/FFmpeg/blob/n7.1/doc/encoders.texi"
  ],
  "notes": [
    "Curated export profiles, not an exhaustive FFmpeg format list.",
    "Input support depends on the installed FFmpeg decoders and demuxers.",
    "Image outputs take the first video frame. GIF uses 12 fps.",
    "PNG, BMP and TIFF are lossless; quality presets do not affect them.",
    "JPEG and H.264 do not preserve transparency. HDR color management is not implemented."
  ],
  "max_upload_bytes": 536870912,
  "qualities": [
    "small",
    "balanced",
    "high"
  ],
  "widths": [
    0,
    640,
    1280,
    1920,
    3840
  ],
  "formats": [
    {
      "id": "mp4",
      "label": "MP4 \u00b7 H.264",
      "kind": "video",
      "extension": "mp4",
      "mime": "video/mp4",
      "encoders": [
        "libx264",
        "aac"
      ],
      "args": [
        "-c:v",
        "libx264",
        "-preset",
        "fast",
        "-pix_fmt",
        "yuv420p",
        "-c:a",
        "aac",
        "-b:a",
        "192k",
        "-movflags",
        "+faststart"
      ],
      "quality_args": {
        "small": [
          "-crf",
          "28"
        ],
        "balanced": [
          "-crf",
          "23"
        ],
        "high": [
          "-crf",
          "18"
        ]
      }
    },
    {
